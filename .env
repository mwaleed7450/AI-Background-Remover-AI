# ============================================================
# AI Module — Environment Variables
# Copy this file to AI-Background-Remover-AI/.env and fill in your values.
# Owned by: AI Team + ML Team
# ============================================================

# ----- Inference Backend -----
# Which segmentation backend to use.
# Options:
#   rembg  — no model file needed, downloads U2-Net automatically (default)
#   onnx   — fastest CPU/GPU inference, requires ONNX_MODEL_PATH
#   torch  — load PyTorch weights directly, requires TORCH_MODEL_PATH
MODEL_BACKEND=rembg

# Path to ONNX model weights (only used when MODEL_BACKEND=onnx)
ONNX_MODEL_PATH=models/model.onnx

# Path to PyTorch model weights (only used when MODEL_BACKEND=torch)
TORCH_MODEL_PATH=models/model.pth

# ----- Input Resolution -----
# Model input size in pixels (width x height).
# U2-Net / BiRefNet / RMBG-2.0 all expect 1024x1024.
# Only change this if you are using a custom model with a different input size.
MODEL_INPUT_SIZE=1024
